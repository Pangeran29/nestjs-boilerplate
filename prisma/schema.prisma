generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id              Int               @unique @default(autoincrement())
  username        String            @unique
  password        String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  role            ERole?
  fcmToken        String?
}

enum ERole {
  Admin
  User
}